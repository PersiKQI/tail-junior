    "nicknameMaxRunes": 40
  },
  "http": {
    "maxBodyBytes": 16384,
    "telemetryMaxEvents": 20,
    "idempotencyKeyPattern": "^[A-Za-z0-9_-]{1,80}$",
    "pageSizeDefault": 50,
    "pageSizeMax": 100
  },
  "learning": {
    "starterAssignments": 12,
    "fullAssignments": 24,
    "practiceMinIntervalHours": 24
  },
  "review": {
    "pairs": { "RS02": 2, "RS07": 7, "RS30": 30 },
    "dueAt": "max(firstAcceptedAt(anchor)) + delayDays * 24h; пара открывается по максимуму двух dueAt"
  },
  "xp": {
    "learningFamilyFirstAccepted": 20,
    "reviewSlotFirstAnsweredOnFinalization": 30,
    "labCaseFamilyFirstComplete": 40,
    "basisKeys": {
      "learning": "learning:{familyId}",
      "review": "review:{programLineage}:{slotFamilyId}",
      "lab": "lab:{caseFamilyId}"
    },
    "maxFullBank": 700,
    "maxStarterOneCase": 460
  },
  "roles": [
    { "id": "newcomer", "title": "Знакомлюсь с инвестициями", "minXp": 0 },
