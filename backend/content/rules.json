    { "id": "look_inside", "title": "Смотрю внутрь", "outcomeId": "sector_concentration" },
    { "id": "check_source", "title": "Проверяю источник", "outcomeId": "independent_verification" },
    { "id": "later_confirmed", "title": "Получилось спустя время", "rule": "первое допустимое LearningEvidence после dueAt" }
  ],
  "cosmetics": {
    "note": "Идентификаторы косметики восстановлены по §14; художественные изображения ещё не созданы. Награда не закрывает уроки, инструменты и проверку знаний.",
    "slots": ["background", "accessory"],
    "items": [
      { "id": "bg-default", "title": "Спокойный фон", "slot": "background", "unlock": "default" },
      { "id": "bg-sunrise", "title": "Рассветный фон", "slot": "background", "unlock": "badge:first_review" },
      { "id": "bg-lab", "title": "Фон лаборатории", "slot": "background", "unlock": "badge:three_scenarios" },
      { "id": "acc-compass", "title": "Компас", "slot": "accessory", "unlock": "badge:own_pace" },
      { "id": "acc-magnifier", "title": "Лупа", "slot": "accessory", "unlock": "badge:check_source" },
      { "id": "acc-calendar", "title": "Календарь", "slot": "accessory", "unlock": "badge:later_confirmed" },
      { "id": "acc-early-ribbon", "title": "Лента «Деньги нужны раньше»", "slot": "accessory", "unlock": "challenge:evt-money-early" }
