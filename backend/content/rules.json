  "badges": [
    { "id": "first_review", "title": "Первый разбор", "rule": "первое принятое learning задание" },
    { "id": "own_pace", "title": "В своём темпе", "rule": "завершён выбранный starter или full маршрут" },
    { "id": "three_scenarios", "title": "Три сценария", "rule": "три сценария разобраны на одном исходном decision" },
    { "id": "money_by_deadline", "title": "Деньги к сроку", "outcomeId": "deadline_access" },
